<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Parlot previews -->
    <add key="Parlot" value="https://f.feedz.io/sebastienros/parlot/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Parlot">
      <package pattern="Parlot" />
      <package pattern="Parlot.SourceGenerator" />
    </packageSource>
  </packageSourceMapping>
</configuration>
