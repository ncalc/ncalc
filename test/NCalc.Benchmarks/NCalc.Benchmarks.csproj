<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Exe</OutputType>
    <Configurations>Debug;Release;SignedRelease</Configurations>
    <Platforms>AnyCPU</Platforms>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);PARLOT_FLUENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Parlot" GeneratePathProperty="true" />
  </ItemGroup>

	<ItemGroup Condition="'$(PkgParlot)' != ''">
		<None Include="$(PkgParlot)\lib\net8.0\Parlot.dll"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="parlot-net8\Parlot.dll"
			  Visible="false" />
		<None Include="$(PkgParlot)\lib\net10.0\Parlot.dll"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="parlot-net10\Parlot.dll"
			  Visible="false" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plugins\NCalc.LambdaCompilation\NCalc.LambdaCompilation.csproj" />
    <Compile Include="../../src/NCalc.Parser/LogicalExpressionParser.parlot.cs" Link="FluentExpressionParser.Grammar.cs" />
    <Compile Include="../../src/NCalc.Parser/LogicalExpressionParser.Helpers.cs" Link="FluentExpressionParser.Helpers.cs" />
  </ItemGroup>

</Project>
