<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- .NET Framework consumers use the .NET Standard 2.0 asset. -->
        <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Default Parlot-based parser for NCalc expressions, including parser options and argument separator configuration.</Description>
        <SignAssembly>true</SignAssembly>
        <RootNamespace>NCalc</RootNamespace>
        <AssemblyOriginatorKeyFile>../../NCalc.snk</AssemblyOriginatorKeyFile>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>obj\$(Configuration)\$(TargetFramework)</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\NCalc.Domain\NCalc.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Parlot.SourceGenerator" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <PackageReference Include="System.Memory" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../NCalc.png">
            <Pack>True</Pack>
            <PackagePath>/</PackagePath>
        </None>
        <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
